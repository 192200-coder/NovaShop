MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/Ecomerce?retryWrites=true&w=majority
PORT=4000
# Dirección exacta del frontend (protocolo y puerto). Se usa para CORS, cookies y URLs de retorno.
CLIENT_ORIGIN=https://localhost:5173

# ===== Pagos: SOLO credenciales de PRUEBA. Nunca subas este archivo a Git. =====

# Mercado Pago (Checkout Pro): Tus integraciones > tu aplicación > Credenciales de prueba > Access Token
MP_ACCESS_TOKEN=
# Opcional: URL pública HTTPS (por ejemplo, un túnel) para el regreso automático después de pagar.
MP_BACK_URL_BASE=
# Opcional: notificaciones (webhooks). Requieren URL pública HTTPS y la "clave secreta" de Webhooks.
MP_WEBHOOK_URL=
MP_WEBHOOK_SECRET=

# Stripe: Developers > API keys (modo de prueba). Solo se aceptan claves sk_test_...
STRIPE_SECRET_KEY=

# PayPal: developer.paypal.com > Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Stripe y PayPal sandbox cobran en dólares: tipo de cambio de prueba PEN -> USD
TIPO_CAMBIO_PEN_USD=3.75

# Simulador local de pagos (sin pasarela). Pon false para ocultarlo.
PAGOS_SIMULADOR=true
